# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox credentials: developer.paypal.com > Apps & Credentials > Sandbox > your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# AI provider: groq, gemini or claude (any capitalisation)
AI_PROVIDER=groq

# Groq: console.groq.com
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional alternatives
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=

# Where this app is reachable (PayPal redirects buyers back here after approval)
BASE_URL=http://localhost:3000
PORT=3000

# Set to 1 to use built-in demo transactions when you have no PayPal credentials
DEMO_MODE=0

# Fee schedule used for pricing answers. The PayPal sandbox charges 3.4% + 0.30.
# Check your own region's real rates before relying on them.
FEE_PERCENT=3.4
FEE_FIXED=0.30
